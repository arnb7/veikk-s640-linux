# VEIKK S640 Graphics Tablet libwacom descriptor
# Place in /etc/libwacom/veikk-s640.tablet or /usr/share/libwacom/veikk-s640.tablet

[Device]
Name=VEIKK S640
ModelName=S640
DeviceMatch=usb|2feb|0001;
Width=152
Height=102
IntegratedIn=
Styli=@generic-no-eraser;@generic-with-eraser;

[Features]
Stylus=true
Reversible=true
Touch=false
Ring=false
